# .harness/harness.toml — install stamp. Managed by the installer; safe to read.
# The one human-facing metadata file. History comes from `git log` on this file;
# the footprint is in the sibling manifest.lock.
name      = "handoff-harness"
flavor    = "{{FLAVOR}}"          # lean | standard
version   = "{{VERSION}}"
commit    = "{{COMMIT}}"
installed = "{{INSTALLED}}"
source    = "github.com/dtammam/handoff-harness"
targets   = [{{TARGETS}}]         # tool integrations to keep in sync, e.g. "claude", "cursor"

[defaults]
anchor      = "{{ANCHOR}}"        # outcome | spec | tdd
involvement = "{{INVOLVEMENT}}"   # interactive | auto
